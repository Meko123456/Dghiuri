<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press Dghiuri's icon: today's entry, without going through the year first. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="write_today"
        android:icon="@drawable/ic_shortcut_write"
        android:shortcutShortLabel="@string/shortcut_write_today_short"
        android:shortcutLongLabel="@string/shortcut_write_today_long">
        <intent
            android:action="io.github.meko123456.dghiuri.action.WRITE_TODAY"
            android:targetClass="io.github.meko123456.dghiuri.MainActivity"
            android:targetPackage="io.github.meko123456.dghiuri" />
    </shortcut>
</shortcuts>
